+def _relocated_or_legacy(
+    relocated: dict, relocated_key: str, legacy: dict, legacy_key: str
+):
+    """Use the relocated X field when that key is present; otherwise legacy."""
+    if relocated_key in relocated:
+        return relocated[relocated_key]
+    return legacy[legacy_key]
 
 
